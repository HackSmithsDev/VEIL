# ======================
# Server Runtime
# ======================
VEIL_HOST=127.0.0.1
VEIL_PORT=8089
VEIL_DEBUG=true
VEIL_ENVIRONMENT='development'

# ======================
# Persistent Storage (PostgreSQL)
# ======================
# PostgreSQL connection string. Inside Compose, 'localhost' is replaced with 'database'.
VEIL_DATABASE_URL='postgresql+psycopg://<your_database_username>:<your_database_password>@localhost:5432/veil'

# ======================
# Cache & Ephemeral State (Redis)
# ======================
# Stores expiring OTPs, refresh tokens, active controller states, and socket connections.
VEIL_REDIS_URL='redis://localhost:6379'

# ======================
# Core Security & Access
# ======================
# JWT signing key; must remain secret, unique per deployment, and at least 32 characters.
VEIL_JWT_SECRET='replace-this-with-a-random-secret-of-at-least-32-characters'
VEIL_ACCESS_TOKEN_MINUTES='30'
VEIL_PASSWORD_RESET_TOKEN_MINUTES='30'
VEIL_PASSWORD_RESET_EMAIL_REQUEST_LIMIT='5'
VEIL_PASSWORD_RESET_HOST_REQUEST_LIMIT='50'
VEIL_PASSWORD_RESET_REQUEST_WINDOW_SECONDS='3600'

# ======================
# Desktop & Frontend Ingress (CORS)
# ======================
# Comma-separated list of trusted origins (Tauri desktop client and local Vite dev servers).
VEIL_CORS_ORIGINS='http://127.0.0.1:5176,http://localhost:5176,tauri://localhost,http://tauri.localhost'

# ======================
# Notification & Mail (SMTP)
# ======================
VEIL_SMTP_HOST='smtp.titan.email'
VEIL_SMTP_PORT='465'
VEIL_SMTP_USERNAME=
VEIL_SMTP_PASSWORD=
VEIL_SMTP_FROM_EMAIL='noreply@hacksmiths.dev'
VEIL_SMTP_FROM_NAME='Veil by HackSmiths'
VEIL_SMTP_STARTTLS='false'
VEIL_SMTP_SSL_TLS='true'
VEIL_SMTP_TIMEOUT_SECONDS='10'

# ======================
# Feedback & Admin Ingestion
# ======================
# Target email inbox for receiving user feedback, audit reports, and crash notices.
VEIL_FEEDBACK_NOTIFICATION_EMAIL=