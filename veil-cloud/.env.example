# Runtime mode; use "production" for deployed environments.
VEIL_ENVIRONMENT=development
VEIL_HOST=127.0.0.1
VEIL_PORT=8089
VEIL_DEBUG=true

# PostgreSQL connection used by Alembic and the API. These credentials are for
# local Docker Compose development only; use private, strong credentials in production.
VEIL_DATABASE_URL=postgresql+psycopg://veil:veil@127.0.0.1:5432/veil

# Redis stores expiring OTP/reset codes (10 minutes by default), refresh tokens,
# connection state, and active controller/model tracking.
VEIL_REDIS_URL=redis://127.0.0.1:6379/0

# Generate a unique random secret (at least 32 characters); never commit a real secret.
VEIL_JWT_SECRET=replace-this-with-a-random-secret-of-at-least-32-characters

# Maximum bearer-token lifetime in minutes.
VEIL_ACCESS_TOKEN_MINUTES=30

# Comma-separated desktop UI origins permitted to call the API.
VEIL_CORS_ORIGINS=http://127.0.0.1:5176,http://localhost:5176,tauri://localhost,http://tauri.localhost

# Optional SMTP notifications. Keep credentials private. Port 587 normally uses
# STARTTLS; port 465 normally uses implicit SSL/TLS. Enable only one TLS mode.
# VEIL_SMTP_HOST=smtp.example.com
# VEIL_SMTP_PORT=587
# VEIL_SMTP_USERNAME=your-smtp-username
# VEIL_SMTP_PASSWORD=your-smtp-password
# VEIL_SMTP_FROM_EMAIL=notifications@example.com
# VEIL_SMTP_FROM_NAME=VEIL Guard
# VEIL_SMTP_STARTTLS=true
# VEIL_SMTP_SSL_TLS=false
# VEIL_SMTP_TIMEOUT_SECONDS=10

# Optional team inbox for new feedback submissions.
# VEIL_FEEDBACK_NOTIFICATION_EMAIL=team@example.com