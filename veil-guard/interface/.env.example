# Vite reads VITE_API_BASE_URL into the frontend at build time.
# This example file is documentation; Vite does not load .env.example directly.
# Copy this file to .env.development for local development, then choose one URL.
#
# Local VEIL Cloud API (development):
VITE_API_BASE_URL=http://127.0.0.1:8089/api/v1
#
# Hosted VEIL Cloud API (production):
# VITE_API_BASE_URL=https://veil-api.hacksmiths.dev/api/v1
#
# For production builds, set VITE_API_BASE_URL in the build environment or a
# local .env.production file. Remote endpoints must use HTTPS; HTTP is allowed
# only for loopback hosts.
