QWidget {
    color: #29283d;
    font-family: "Avenir Next", "Segoe UI", sans-serif;
    font-size: 10pt;
}

QWizard {
    background: #ffffff;
}

QWizardPage {
    background: #ffffff;
}

QLabel#TitleLabel {
    color: #29283d;
    font-size: 19pt;
    font-weight: 700;
}

QLabel#SubTitleLabel {
    color: #747688;
    font-size: 10pt;
}

QPushButton {
    min-width: 84px;
    min-height: 30px;
    padding: 3px 14px;
    border: 1px solid #dedde9;
    border-radius: 5px;
    color: #514b79;
    background: #ffffff;
}

QPushButton:hover {
    border-color: #8c80e7;
    background: #f7f6ff;
}

QPushButton:default {
    border-color: #6557d2;
    color: #ffffff;
    background: #6557d2;
}

QPushButton:default:hover {
    background: #5144ba;
}

QPushButton:disabled {
    color: #a5a5b0;
    background: #f4f4f7;
}

QCheckBox, QRadioButton {
    spacing: 8px;
}

QLineEdit {
    min-height: 26px;
    padding: 3px 8px;
    border: 1px solid #dedde9;
    border-radius: 4px;
    selection-background-color: #6557d2;
}

QLineEdit:focus {
    border-color: #8c80e7;
}

QProgressBar {
    min-height: 10px;
    border: 0;
    border-radius: 5px;
    background: #efeff5;
    text-align: center;
}

QProgressBar::chunk {
    border-radius: 5px;
    background: #6557d2;
}
